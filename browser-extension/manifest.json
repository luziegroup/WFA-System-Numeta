{
  "manifest_version": 3,
  "name": "WFA System — Pelacak Alamat",
  "version": "1.2.0",
  "description": "Mencatat alamat situs yang dibuka saat timer Hubstaff WFA System aktif. Terhubung otomatis saat karyawan membuka WFA System di browser.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["tabs", "storage", "alarms", "idle", "scripting"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icons/icon48.png" },
  "options_page": "options.html",
  "minimum_chrome_version": "116"
}
